class Test:
    public let pub_let: int
    private var priv_var: int
    const const_field: int = 42
    final final_field: int = 99

    Test():
        this.pub_let = 1
        this.priv_var = 2
    end

    def get_priv() -> int:
        return this.priv_var
    end
end

let t = new Test()
println(t.pub_let)
println(t.get_priv())
println(t.const_field)
println(t.final_field)
