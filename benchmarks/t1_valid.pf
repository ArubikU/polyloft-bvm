// Test 1: Valid - ctor writes to final and const, class method writes to const
class WithFinal:
    final MAX: int = 100
    const counter: int
    let name: string

    WithFinal():
        this.MAX = 100
        this.counter = 0
        this.name = "test"
    end

    def increment() -> void:
        this.counter = this.counter + 1
    end
end

let wf = new WithFinal()
println(wf.MAX)
wf.increment()
println(wf.counter)
wf.name = "hello"
println(wf.name)
