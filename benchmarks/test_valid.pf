// === VALID cases ===

class WithFinal:
    final MAX: int = 100

    WithFinal():
        this.MAX = 100
    end
end

class WithConst:
    const counter: int

    WithConst():
        this.counter = 0
    end

    def set_counter(v: int) -> void:
        this.counter = v
    end
end

let wf = new WithFinal()
println(wf.MAX)            // expect: 100
let wc = new WithConst()
wc.set_counter(42)
println(wc.counter)        // expect: 42
