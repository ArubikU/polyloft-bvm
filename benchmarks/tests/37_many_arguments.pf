class ArgTester:
    def test(a: int, b: int, c: int, d: int, e: int, f: int, g: int) -> int:
        return a + b + c + d + e + f + g
    end
end

var started = Sys.time()
var obj = new ArgTester()
var s = 0
for i in range(0, 1000000):
    s = s + obj.test(1, 1, 1, 1, 1, 1, 1)
end
var ended = Sys.time()
println(s)
println("TIME_PF")
println(ended - started)
