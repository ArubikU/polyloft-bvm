class TestImmutable:
    public const MAX: int = 100
    private var counter: int
    protected final LIMIT: int = 50

    TestImmutable():
        this.MAX = 100
        this.counter = 0
        this.LIMIT = 50
    end

    def increment() -> void:
        this.counter = this.counter + 1
    end

    def get_counter() -> int:
        return this.counter
    end
end

let t = new TestImmutable()
println(t.MAX)
t.increment()
println(t.get_counter())
