class Simple:
    x: int
    y: int

    Simple(val: int):
        this.x = val
        this.y = 0
    end

    Simple(val: int, extra: int):
        this.x = val
        this.y = extra
    end
end

let obj1 = new Simple(10)
let obj2 = new Simple(10, 20)
println(obj1.x)
println(obj1.y)
println(obj2.x)
println(obj2.y)
