// ── Assemble main window ──────────────────────────────────────────────────────
var win = app.window("Polyloft – Developer Dashboard", 1060, 720)
win.root(root)

win.on("nav-overview",  on_nav)
win.on("nav-builds",    on_nav)
win.on("nav-logs",      on_nav)
win.on("nav-settings",  on_nav)
win.on("sidebar-nav",   on_nav)
win.on("volume-change", on_volume)
win.on("deploy",        on_action)
