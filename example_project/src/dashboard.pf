// ── Volume slider ─────────────────────────────────────────────────────────────
main.add(VolumeSlider("Worker Concurrency  (0 – 16)", 8, 16))

body.add(main)

// ─── Right panel: Live log feed ───────────────────────────────────────────────
var logPanel = UI.view()
logPanel.set("direction", "column")
logPanel.set("justify", "start")
logPanel.set("align", "stretch")
logPanel.set("padx", 12)
logPanel.set("pady", 14)
logPanel.set("gap", 6)
logPanel.set("width", 320)
logPanel.setClass("bg-panel")

logPanel.add(SectionHeader("Live Log"))
logPanel.add(Divider())

var logLines = [
    ["12:40:01", "ok",    "Pipeline started – build #4521"],
    ["12:40:03", "info",  "Pulling image polyloft/ci:2.1.0"],
    ["12:40:08", "ok",    "Dependencies installed (512 pkgs)"],
    ["12:40:11", "info",  "Running unit tests…"],
    ["12:40:19", "warn",  "Flaky test detected – retrying"],
    ["12:40:25", "ok",    "Unit tests passed  (318/318)"],
    ["12:40:27", "info",  "Starting integration suite"],
    ["12:40:41", "error", "Test: TestAuthFlow – timeout"],
    ["12:40:41", "error", "Test: TestDBMigration – conn err"],
    ["12:40:42", "warn",  "Retrying 2 failed tests…"],
    ["12:40:55", "error", "Integration suite FAILED (3 err)"],
    ["12:40:56", "info",  "Artifacts archived to /tmp/ci"],
