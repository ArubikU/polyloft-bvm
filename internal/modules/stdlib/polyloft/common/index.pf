public class Integer:
	let value: int

	Integer(value: int):
		this.value = value
	end

	def intValue() -> int:
		return (int) this.value
	end

	def floatValue() -> float:
		return this.value
	end

	def doubleValue() -> float:
		return this.value
	end

	def abs() -> Integer:
		if this.value < 0:
			return Integer(-this.value)
		end
		return Integer(this.value)
	end

	def negate() -> Integer:
		return Integer(-this.value)
	end

	def isZero() -> bool:
		return this.value == 0
	end

	def isPositive() -> bool:
		return this.value > 0
	end

	def isNegative() -> bool:
		return this.value < 0
	end

	def signum() -> int:
		if this.value < 0:
			return -1
		end
		if this.value > 0:
			return 1
		end
		return 0
	end

	def max(other: int) -> Integer:
		if this.value >= other:
			return Integer(this.value)
		end
		return Integer(other)
	end

	def min(other: int) -> Integer:
		if this.value <= other:
			return Integer(this.value)
		end
		return Integer(other)
	end

	def compareTo(other: int) -> int:
		if this.value < other:
			return -1
		end
		if this.value > other:
			return 1
		end
		return 0
	end

	def equals(other: any) -> bool:
		return this.value == other
	end

	def toString() -> string:
		return "" + this.value
	end

	def unwrap() -> int:
		return this.value
	end
end

