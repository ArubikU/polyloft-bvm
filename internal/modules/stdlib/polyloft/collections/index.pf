public interface List:
	size() -> number
	isEmpty() -> bool
	add(element: any) -> void
	remove(element: any) -> bool
	contains(element: any) -> bool
	clear() -> void
	asArray() -> array
	__length() -> number
	__get(index: int) -> any
	__set(index: int, value: any) -> void
	__contains(element: any) -> bool
	__slice(start: int, finish: int) -> any
	get(index: int) -> any
	set(index: int, value: any) -> void
end

public interface Deque:
	size() -> number
	isEmpty() -> bool
	add(element: any) -> void
	remove(element: any) -> bool
	contains(element: any) -> bool
	clear() -> void
	asArray() -> array
	addFirst(element: any) -> void
	addLast(element: any) -> void
	removeFirst() -> any
	removeLast() -> any
end

public interface Set:
	size() -> number
	isEmpty() -> bool
	add(element: any) -> void
	remove(element: any) -> bool
	contains(element: any) -> bool
	clear() -> void
	asArray() -> array
	values() -> array
end

public class ArrayList implements List:
	var items: array

	ArrayList():
		this.items = []
	end

	def size() -> number:
		return len(this.items)
	end

	def isEmpty() -> bool:
		return this.size() == 0
	end

	def add(element: any) -> void:
		this.items = this.items + [element]
	end

	def remove(element: any) -> bool:
		for idx in range(0, len(this.items)):
			if this.items[idx] == element:
				var before: array = []
				if idx > 0:
					before = this.items[0...idx-1]
				end
				var after: array = []
				if idx < len(this.items)-1:
					after = this.items[idx+1...len(this.items)-1]
				end
				this.items = before + after
				return true
			end
		end
		return false
	end

	def contains(element: any) -> bool:
		for item in this.items:
			if item == element:
				return true
			end
		end
		return false
	end

	def clear() -> void:
		this.items = []
	end

	def asArray() -> array:
		return this.items
	end

	def __length() -> number:
		return this.size()
	end

	def __get(index: int) -> any:
		return this.items[index]
	end

	def __set(index: int, value: any) -> void:
		this.items[index] = value
	end

	def __contains(element: any) -> bool:
		return this.contains(element)
	end

	def __slice(start: int, finish: int) -> any:
		return this.items[start...finish]
	end

	def get(index: int) -> any:
		return this.items[index]
	end

	def set(index: int, value: any) -> void:
		this.items[index] = value
	end
end

// simple linked list implementation (backed by internal array for simplicity)
public class LinkedList implements List:
	var items: array

	LinkedList():
		this.items = []
	end

	def size() -> number:
		return len(this.items)
	end

	def isEmpty() -> bool:
		return this.size() == 0
	end

	def add(element: any) -> void:
		this.items = this.items + [element]
	end

	def remove(element: any) -> bool:
		for idx in range(0, len(this.items)):
			if this.items[idx] == element:
				var before: array = []
				if idx > 0:
					before = this.items[0...idx-1]
				end
				var after: array = []
				if idx < len(this.items)-1:
					after = this.items[idx+1...len(this.items)-1]
				end
				this.items = before + after
				return true
			end
		end
		return false
	end

	def contains(element: any) -> bool:
		for item in this.items:
			if item == element:
				return true
			end
		end
		return false
	end

	def clear() -> void:
		this.items = []
	end

	def asArray() -> array:
		return this.items
	end

	def __length() -> number:
		return this.size()
	end

	def __get(index: int) -> any:
		return this.items[index]
	end

	def __set(index: int, value: any) -> void:
		this.items[index] = value
	end

	def __contains(element: any) -> bool:
		return this.contains(element)
	end

	def __slice(start: int, finish: int) -> any:
		return this.items[start...finish]
	end

	def get(index: int) -> any:
		return this.items[index]
	end

	def set(index: int, value: any) -> void:
		this.items[index] = value
	end
end

public class HashSet implements Set:
	var entries: map

	HashSet():
		this.entries = {}
	end

	static def from(items: array) -> HashSet:
		let values = HashSet()
		for item in items:
			values.add(item)
		end
		return values
	end

	def size() -> number:
		return len(this.entries)
	end

	def isEmpty() -> bool:
		return this.size() == 0
	end

	def add(key: any) -> void:
		this.entries[hash(key)] = key
	end

	def remove(key: any) -> bool:
		return delete(this.entries, hash(key))
	end

	def contains(key: any) -> bool:
		return hash(key) in this.entries
	end

	def clear() -> void:
		this.entries = {}
	end

	def asArray() -> array:
		return values(this.entries)
	end

	def values() -> array:
		return values(this.entries)
	end
end
