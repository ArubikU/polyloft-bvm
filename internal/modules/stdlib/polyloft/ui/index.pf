public class StyleSheet:
	var _native: any

	StyleSheet():
		this._native = stylesheet_new()
	end

	StyleSheet(nativeSS: any):
		if nativeSS == nil:
			this._native = stylesheet_new()
		else:
			this._native = nativeSS
		end
	end

	// parse(css) – load CSS from a string.
	// Supports .classname { property: value } syntax and comma-separated selectors.
	def parse(css: string) -> int:
		return stylesheet_parse(this._native, css)
	end

	// loadFile(path) – load and parse a .css file.
	def loadFile(path: string) -> int:
		return stylesheet_load_file(this._native, path)
	end

	// set(className, property, value) – programmatic rule.
	// className may start with "." or not.
	def set(className: string, property: string, value: string) -> StyleSheet:
		stylesheet_set(this._native, className, property, value)
		return this
	end

	// get(className, property) – retrieve a stored rule value.
	def get(className: string, property: string) -> string:
		return stylesheet_get(this._native, className, property)
	end
end

public class UINode:
	var _native: any

	UINode(kind: string):
		this._native = node_new(kind)
	end

	UINode(nativeNode: any):
		this._native = nativeNode
	end

	def set(name: string, value: any) -> UINode:
		node_set_prop(this._native, name, value)
		return this
	end

	// DOM-like alias: setAttribute(name, value)
	def setAttribute(name: string, value: any) -> UINode:
		return this.set(name, value)
	end

	// DOM-like alias: appendChild(node)
	def appendChild(child: UINode) -> UINode:
		return this.add(child)
	end

	// DOM-like alias: className("a b c")
	def className(className: string) -> UINode:
		return this.setClass(className)
	end

	// DOM-like helper: textContent(value)
	def textContent(content: string) -> UINode:
		return this.set("text", content)
	end

	// style(prop, val) – inline CSS property, highest priority.
	// Accepts standard CSS names: "color", "background-color", "font-size",
	// "font-weight", "font-style", "text-align", "padding", "width", "height", etc.
	def style(name: string, value: any) -> UINode:
		node_set_style(this._native, name, value)
		return this
	end

	// setClass(className) – replace the entire class list for this node.
	def setClass(className: string) -> UINode:
		node_set_class(this._native, className)
		return this
	end

	// addClass(className) – append a class to the existing class list.
	def addClass(className: string) -> UINode:
		node_add_class(this._native, className)
		return this
	end

	def add(child: UINode) -> UINode:
		node_add_child(this._native, child._native)
		return this
	end

	static def view() -> UINode:
		return UINode("View")
	end

	static def text(content: string) -> UINode:
		let node = UINode("Text")
		node.set("text", content)
		return node
	end

	// span is the canonical alias of Text (same behavior as text currently).
	static def span(content: string) -> UINode:
		return UINode.text(content)
	end

	static def label(content: string) -> UINode:
		let node = UINode.text(content)
		node.set("tag", "label")
		return node
	end

	static def p(content: string) -> UINode:
		let node = UINode.text(content)
		node.set("tag", "p")
		return node
	end

	static def h1(content: string) -> UINode:
		let node = UINode.text(content)
		node.set("tag", "h1")
		return node
	end

	static def h2(content: string) -> UINode:
		let node = UINode.text(content)
		node.set("tag", "h2")
		return node
	end

	static def h3(content: string) -> UINode:
		let node = UINode.text(content)
		node.set("tag", "h3")
		return node
	end

	static def h4(content: string) -> UINode:
		let node = UINode.text(content)
		node.set("tag", "h4")
		return node
	end

	static def button(label: string) -> UINode:
		let node = UINode("Button")
		node.set("text", label)
		return node
	end

	static def input() -> UINode:
		return UINode.input("text")
	end

	static def input(inputType: string) -> UINode:
		let node = UINode("Input")
		node.set("type", inputType)
		return node
	end

	static def img(src: string) -> UINode:
		let node = UINode("Native")
		node.set("component", "image")
		node.set("src", src)
		return node
	end

	static def image(src: string) -> UINode:
		return UINode.img(src)
	end

	// DOM-like factory: createElement(tag)
	static def createElement(tag: string) -> UINode:
		let t = tag
		if t == "div" || t == "section" || t == "article" || t == "main" || t == "aside" || t == "header" || t == "footer" || t == "nav":
			return UINode.view()
		end
		if t == "span":
			return UINode.span("")
		end
		if t == "label":
			return UINode.label("")
		end
		if t == "p":
			return UINode.p("")
		end
		if t == "h1":
			return UINode.h1("")
		end
		if t == "h2":
			return UINode.h2("")
		end
		if t == "h3":
			return UINode.h3("")
		end
		if t == "h4":
			return UINode.h4("")
		end
		if t == "button":
			return UINode.button("")
		end
		if t == "input":
			return UINode.input("text")
		end
		if t == "textarea":
			return UINode.input("textarea")
		end
		if t == "img" || t == "image":
			return UINode.img("")
		end
		return UINode(tag)
	end

	static def createTextNode(content: string) -> UINode:
		return UINode.text(content)
	end
end

public class UIDocument:
	def createElement(tag: string) -> UINode:
		return UINode.createElement(tag)
	end

	def createTextNode(content: string) -> UINode:
		return UINode.createTextNode(content)
	end

	def append(parent: UINode, child: UINode) -> UINode:
		parent.add(child)
		return parent
	end
end

public class UIWindow:
	var _native: any
	var _app: UIApp

	UIWindow(app: UIApp, title: string, width: int, height: int):
		this._app = app
		this._native = window_new(app._native, title, width, height)
	end

	def root(node: UINode) -> UIWindow:
		window_set_root(this._native, node._native)
		return this
	end

	def setTitle(title: string) -> bool:
		return window_set_title(this._native, title)
	end

	def setIcon(path: string) -> bool:
		return window_set_icon(this._native, path)
	end

	def on(eventName: string, callback: any) -> bool:
		return window_bind(this._native, eventName, callback)
	end

	def trigger(eventName: string, payload: any) -> bool:
		return window_trigger(this._native, eventName, payload)
	end

	def json() -> string:
		return window_to_json(this._native)
	end

	def layoutJson() -> string:
		return window_layout_json(this._native)
	end

	def reconcile(node: UINode) -> map<string, any>:
		return window_reconcile(this._native, node._native)
	end

	def lastPatchJson() -> string:
		return window_last_patch_json(this._native)
	end

	def lastTransitionJson() -> string:
		return window_last_transition_json(this._native)
	end

	def show() -> bool:
		return window_show(this._native)
	end

	def print(path: string) -> bool:
		return window_print(this._native, path)
	end

	// close() – hide and close this window.
	def close() -> bool:
		return window_close(this._native)
	end

	// setHeadless(true) – remove OS padding/decorations (best-effort).
	// Build a custom title bar as UINode children for a fully custom chrome.
	def setHeadless(enabled: bool) -> bool:
		return window_set_headless(this._native, enabled)
	end

	// debug(true) – draw debug overlays for node bounds, interaction areas and scroll clips.
	// debug({"frames": true, "fpscounter": true}) – lightweight profiler overlay.
	def debug(config: any) -> bool:
		return window_debug(this._native, config)
	end

	// Alias explícito para perfilador.
	def debugProfile(flags: map<string, any>) -> bool:
		return window_debug_profile(this._native, flags)
	end
end

public class UIApp:
	var _native: any

	UIApp(backend: string):
		this._native = app_new(backend)
	end

	def allowProfile(profile: string) -> UIApp:
		app_allow_profile(this._native, profile)
		return this
	end

	def setName(name: string) -> UIApp:
		app_set_name(this._native, name)
		return this
	end

	def setIcon(path: string) -> bool:
		return app_set_icon(this._native, path)
	end

	def loadFont(pathOrUrl: string) -> bool:
		return app_load_font(this._native, pathOrUrl)
	end

	def setPermission(name: string, allowed: bool) -> bool:
		return app_set_permission(this._native, name, allowed)
	end

	def hasPermission(name: string) -> bool:
		return app_has_permission(this._native, name)
	end

	def permissions() -> map<string, any>:
		return app_permissions(this._native)
	end

	def platform() -> string:
		return app_platform(this._native)
	end

	def eventChannel(capacity: int) -> any:
		return app_event_channel(this._native, capacity)
	end

	def emit(name: string, payload: any) -> bool:
		return app_emit_event(this._native, name, payload)
	end

	def channel(name: string, capacity: int) -> UIChannel:
		app_channel_new(this._native, name, capacity)
		return UIChannel(this, name)
	end

	def dispatch(callback: any, payload: any) -> any:
		return app_dispatch(this._native, callback, payload)
	end

	def dispatchAsync(callback: any, payload: any) -> CompletableFuture<any>:
		let nativeApp = this._native
		return async(() => app_dispatch(nativeApp, callback, payload))
	end

	def post(callback: any, payload: any, priority: int) -> int:
		return app_post(this._native, callback, payload, priority)
	end

	def cancelTask(taskId: int) -> bool:
		return app_cancel_task(this._native, taskId)
	end

	def runOnUiThread(maxTasks: int) -> int:
		return app_run_on_ui_thread(this._native, maxTasks)
	end

	def startUiLoop(timeSliceMs: int, maxTasksPerTick: int) -> bool:
		return app_start_ui_loop(this._native, timeSliceMs, maxTasksPerTick)
	end

	// attachStylesheet(ss) – attach a StyleSheet to this app so all nodes can use class names.
	def attachStylesheet(ss: StyleSheet) -> UIApp:
		app_attach_stylesheet(this._native, ss._native)
		return this
	end

	// quit() – close all windows and terminate the app.
	def quit() -> void:
		app_quit(this._native)
	end

	def stopUiLoop() -> bool:
		return app_stop_ui_loop(this._native)
	end

	def isUiLoopRunning() -> bool:
		return app_ui_loop_running(this._native)
	end

	def window(title: string, width: int, height: int) -> UIWindow:
		return UIWindow(this, title, width, height)
	end

	def run() -> void:
		app_run(this._native)
	end

	static def create(backend: string) -> UIApp:
		return UIApp(backend)
	end
end

public class UIChannel:
	var _app: UIApp
	var _name: string

	UIChannel(app: UIApp, name: string):
		this._app = app
		this._name = name
	end

	def send(payload: any) -> bool:
		return app_channel_send(this._app._native, this._name, payload)
	end

	def receive() -> any:
		return app_channel_receive(this._app._native, this._name)
	end

	def close() -> bool:
		return app_channel_close(this._app._native, this._name)
	end
end

public class UI:
	static def app(backend: string) -> UIApp:
		return UIApp(backend)
	end

	static def node(kind: string) -> UINode:
		return UINode(kind)
	end

	static def document() -> UIDocument:
		return UIDocument()
	end

	static def view() -> UINode:
		return UINode.view()
	end

	static def text(content: string) -> UINode:
		return UINode.text(content)
	end

	static def span(content: string) -> UINode:
		return UINode.span(content)
	end

	static def label(content: string) -> UINode:
		return UINode.label(content)
	end

	static def p(content: string) -> UINode:
		return UINode.p(content)
	end

	static def h1(content: string) -> UINode:
		return UINode.h1(content)
	end

	static def h2(content: string) -> UINode:
		return UINode.h2(content)
	end

	static def h3(content: string) -> UINode:
		return UINode.h3(content)
	end

	static def h4(content: string) -> UINode:
		return UINode.h4(content)
	end

	static def button(label: string) -> UINode:
		return UINode.button(label)
	end

	static def input() -> UINode:
		return UINode.input("text")
	end

	static def input(inputType: string) -> UINode:
		return UINode.input(inputType)
	end

	static def icon(name: string) -> UINode:
		let node = UINode("Native")
		node.set("component", "icon")
		node.set("name", name)
		return node
	end

	static def image(src: string) -> UINode:
		let node = UINode("Native")
		node.set("component", "image")
		node.set("src", src)
		return node
	end

	static def img(src: string) -> UINode:
		return UI.image(src)
	end

	static def nativeComponent(component: string) -> UINode:
		let node = UINode("Native")
		node.set("component", component)
		return node
	end

	// stylesheet() – create a new empty StyleSheet.
	// Call app.attachStylesheet(ss) to make it active for all nodes.
	static def stylesheet() -> StyleSheet:
		return StyleSheet(nil)
	end

	static def post(app: UIApp, callback: any, payload: any, priority: int) -> int:
		return app.post(callback, payload, priority)
	end

	static def runOnUiThread(app: UIApp, maxTasks: int) -> int:
		return app.runOnUiThread(maxTasks)
	end

	static def print(window: UIWindow, path: string) -> bool:
		return window.print(path)
	end
end

public class UIContext:
	var _values: map<string, any>
	var _watchers: map<string, any>

	UIContext():
		this._values = {}
		this._watchers = {}
	end

	def set(key: string, value: any) -> UIContext:
		this._values[key] = value
		var watcher = this._watchers[key]
		if watcher != nil:
			watcher(key, value, this)
		end
		return this
	end

	def get(key: string) -> any:
		return this._values[key]
	end

	def has(key: string) -> bool:
		return this._values[key] != nil
	end

	def values() -> map<string, any>:
		return this._values
	end

	def subscribe(key: string, callback: any) -> UIContext:
		this._watchers[key] = callback
		return this
	end
end

public class UIRouter:
	var _window: UIWindow
	var _routes: map<string, any>
	var _current: string
	var _context: UIContext
	var _previous: string
	var _onChange: any
	var _params: map<string, any>

	UIRouter(window: UIWindow):
		this._window = window
		this._routes = {}
		this._current = ""
		this._context = UIContext()
		this._previous = ""
		this._onChange = nil
		this._params = {}
	end

	def context() -> UIContext:
		return this._context
	end

	def register(path: string, builder: any) -> UIRouter:
		this._routes[path] = builder
		return this
	end

	def onChange(listener: any) -> UIRouter:
		this._onChange = listener
		return this
	end

	def current() -> string:
		return this._current
	end

	def params() -> map<string, any>:
		return this._params
	end

	def previous() -> string:
		return this._previous
	end

	def _emit(payload: any) -> void:
		if this._onChange != nil:
			this._onChange(payload)
		end
	end

	def navigate(path: string, payload: any) -> bool:
		var builder = this._routes[path]
		if builder == nil:
			return false
		end
		var routeParams = {}
		if payload != nil:
			var maybeParams = payload["params"]
			if maybeParams != nil:
				routeParams = maybeParams
			end
		end
		this._params = routeParams
		var nextRoot = builder(payload, this._context, routeParams)
		if nextRoot == nil:
			nextRoot = builder(payload, this._context)
		end
		if nextRoot == nil:
			return false
		end
		this._previous = this._current
		this._current = path
		this._window.reconcile(nextRoot)
		this._emit({"path": path, "previous": this._previous, "params": this._params, "payload": payload})
		return true
	end

	def replace(path: string, payload: any) -> bool:
		var builder = this._routes[path]
		if builder == nil:
			return false
		end
		var routeParams = {}
		if payload != nil:
			var maybeParams = payload["params"]
			if maybeParams != nil:
				routeParams = maybeParams
			end
		end
		this._params = routeParams
		var nextRoot = builder(payload, this._context, routeParams)
		if nextRoot == nil:
			nextRoot = builder(payload, this._context)
		end
		if nextRoot == nil:
			return false
		end
		this._current = path
		this._window.reconcile(nextRoot)
		this._emit({"path": path, "previous": this._previous, "params": this._params, "payload": payload, "replace": true})
		return true
	end

	def back(payload: any) -> bool:
		if this._previous == "":
			return false
		end
		return this.replace(this._previous, payload)
	end

	def start(path: string, payload: any) -> bool:
		return this.navigate(path, payload)
	end
end
