class Simple:
    x: int

    Simple():
        this.x = 0
    end

    def init(val: int) -> void:
        this.x = val
    end
end

var started = Sys.time()
var s = 0
for i in range(0, 100000):
    var obj = new Simple()
    obj.init(i)
    s = s + 1
end
var ended = Sys.time()
println(s)
println("TIME_PF")
println(ended - started)
