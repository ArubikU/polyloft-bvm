class A:
    def m() -> int:
        return 1
    end
end
class B extends A:
    def m() -> int:
        return 2
    end
end
class C extends B:
    def m() -> int:
        return 3
    end
end
class D extends C:
    def m() -> int:
        return 4
    end
end

var started = Sys.time()
var obj = new D()
var s = 0
for i in range(0, 250000):
    s = s + obj.m()
end
var ended = Sys.time()
println(s)
println("TIME_PF")
println(ended - started)
